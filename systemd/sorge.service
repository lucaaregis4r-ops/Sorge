[Unit]
Description=Sorge - Assistente Pessoal Local (Telegram Gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lucasregis/Área de trabalho/Projetos/Backup/Sorge
ExecStart=/bin/bash "/home/lucasregis/Área de trabalho/Projetos/Backup/Sorge/scripts/start-sorge.sh" --foreground
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
