[Unit]
Description=Sorge - Assistente Pessoal Local (Telegram Gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Área de trabalho/Projetos/Backup/Sorge
ExecStart=%h/Área de trabalho/Projetos/Backup/Sorge/.venv/bin/python3 -m sorge_gateway.main
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

# Gravação de logs
StandardOutput=append:%h/Área de trabalho/Projetos/Backup/Sorge/logs/sorge.log
StandardError=append:%h/Área de trabalho/Projetos/Backup/Sorge/logs/error.log

[Install]
WantedBy=default.target
