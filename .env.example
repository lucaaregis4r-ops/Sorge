# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_ALLOWED_USER_ID=seu_telegram_user_id_aqui

# Banco de Dados
DATABASE_PATH=data/sorge.db

# Configurações do Sistema
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# n8n Webhook / API
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# OpenClaw Local (Gateway já rodando na sua máquina na porta 18789)
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=seu_openclaw_token_aqui
OPENCLAW_MODEL=openai/gpt-6-astra
